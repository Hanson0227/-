            /**
             * 將單字移出不熟清單並提供「復原」Undo Toast
             */
            function graduateWordWithUndo(wordId) {
                const prevSnapshot = { ...getWordRecord(wordId) };
                const wordObj = VOCAB_BY_ID.get(wordId);

                markWordLearned(wordId);
                playTone(true);

                if (getUnlearnedWords().length === 0) {
                    state.m4JustCelebrated = true;
                }

                showToast(`「${wordObj ? wordObj.en : ''}」已移出不熟清單`, () => {
                    // 復原為先前的 unlearned 狀態與紀錄
                    state.wordData[wordId] = {
                        status: 'unlearned',
                        struggleCount: Math.max(1, prevSnapshot.struggleCount || 1),
                        updatedAt: prevSnapshot.updatedAt || Date.now()
                    };
                    state.m4JustCelebrated = false;
                    saveState();
                    updateGlobalCounters();
                    if (state.mode === 'mode4') renderMode4();
                });

                if (state.mode === 'mode4') {
                    renderMode4();
                }
            }

            /* ---------- 子模式 4-2：🗂️ 不熟單字卡專攻 ---------- */
