            /**
             * 建立精簡可跨裝置複製的 JSON 備份字串
             */
            function generateBackupString() {
                const payload = {
                    app: 'ntu450',
                    v: 2,
                    exportedAt: new Date().toISOString(),
                    wordData: state.wordData,
                    stats: state.stats
                };
                return JSON.stringify(payload);
            }

            function openBackupModal() {
                document.getElementById('backupExportText').value = generateBackupString();
                document.getElementById('backupImportText').value = '';
                const fb = document.getElementById('backupImportFeedback');
                fb.classList.add('hidden');
                document.getElementById('resetInitialRow').classList.remove('hidden');
                document.getElementById('resetConfirmRow').classList.add('hidden');
                document.getElementById('backupModal').classList.remove('hidden');
            }

            /**
             * 使用 document.execCommand('copy') 確保在 iFrame 與 iPad Safari 皆可順利複製
             */
            function copyBackupToClipboard() {
                const ta = document.getElementById('backupExportText');
                ta.focus();
                ta.select();
                ta.setSelectionRange(0, 999999);
                try {
                    const ok = document.execCommand('copy');
                    showToast(ok ? '已複製備份碼！可直接貼到另一台裝置還原' : '請長按上方文字框手動全選複製');
                } catch (err) {
                    showToast('請長按上方文字框手動全選複製');
                }
            }

            function downloadBackupJson() {
                try {
                    const blob = new Blob([generateBackupString()], { type: 'application/json' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `ntu450_progress_${new Date().toISOString().slice(0, 10)}.json`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                    showToast('已下載 JSON 備份檔案');
                } catch (err) {
                    showToast('下載失敗，請使用「複製備份碼」功能');
                }
            }

            function importBackupString() {
                const raw = document.getElementById('backupImportText').value.trim();
                const fb = document.getElementById('backupImportFeedback');
                fb.classList.remove('hidden', 'text-emerald-600', 'dark:text-emerald-400', 'text-rose-600', 'dark:text-rose-400');

                if (!raw) {
                    fb.textContent = '請先貼上備份碼再按匯入。';
                    fb.classList.add('text-rose-600', 'dark:text-rose-400');
                    return;
                }

                try {
                    const parsed = JSON.parse(raw);
                    if (!parsed || typeof parsed !== 'object' || !parsed.wordData || typeof parsed.wordData !== 'object') {
                        throw new Error('格式無效');
                    }

                    // 驗證並清洗匯入資料
                    const cleanData = {};
                    Object.keys(parsed.wordData).forEach(k => {
                        const id = parseInt(k, 10);
                        const rec = parsed.wordData[k];
                        if (VOCAB_BY_ID.has(id) && rec && (rec.status === 'unlearned' || rec.status === 'learned')) {
                            cleanData[id] = {
                                status: rec.status,
                                struggleCount: Number(rec.struggleCount) || (rec.status === 'unlearned' ? 1 : 0),
                                updatedAt: Number(rec.updatedAt) || Date.now()
                            };
                        }
                    });

                    state.wordData = cleanData;
                    if (parsed.stats && typeof parsed.stats === 'object') {
                        state.stats = {
                            total: Number(parsed.stats.total) || 0,
                            correct: Number(parsed.stats.correct) || 0,
                            streak: Number(parsed.stats.streak) || 0
                        };
                    }
                    saveState();
                    updateGlobalCounters();
                    document.getElementById('backupExportText').value = generateBackupString();

                    fb.textContent = `還原成功！共載入 ${Object.keys(cleanData).length} 筆單字學習紀錄。`;
                    fb.classList.add('text-emerald-600', 'dark:text-emerald-400');
                    showToast('學習進度已成功還原！');
                    renderActiveMode();
                } catch (err) {
                    fb.textContent = '備份碼格式不正確，請確認已完整複製整段 JSON 內容。';
                    fb.classList.add('text-rose-600', 'dark:text-rose-400');
                }
            }

