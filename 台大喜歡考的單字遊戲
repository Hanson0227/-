            const VOCAB_LIST = RAW_VOCAB_DATA.split('\n').map(line => {
                const parts = line.split('|');
                return {
                    id: parseInt(parts[0], 10),
                    en: parts[1].trim(),
                    zh: parts.slice(2).join('|').trim()
                };
            });

            const VOCAB_BY_ID = new Map(VOCAB_LIST.map(w => [w.id, w]));

            /* =========================================================================
             * 2. 狀態管理與 localStorage 持久化（含舊版 v1 無痛升級）
             * ========================================================================= */
            const STORAGE_KEY_V2 = 'ntu_vocab_450_state_v2';
            const STORAGE_KEY_V1 = 'ntu_vocab_450_state_v1';

            const WEIGHTS = {
                unlearned: 8,
                unmarked: 3,
                learned: 0.5
            };

            const state = {
                mode: 'mode1',            // 'mode1' | 'mode2' | 'mode3' | 'mode4'
                range: 'all',             // 'all' | '1-100' ... '401-450'
                theme: 'light',           // 'light' | 'dark'
                autoAddWrong: true,       // 答錯自動加入不熟清單
                autoSpeakMode2: true,     // 模式 2 答後自動朗讀
                // 單字紀錄: { [id]: { status: 'unlearned'|'learned', struggleCount: number, updatedAt: number } }
                wordData: {},
                stats: {
                    total: 0,
                    correct: 0,
                    streak: 0
                },
                // 模式 1 & 2 執行期狀態
                quizWord: null,
                quizOptions: [],
                quizAnswered: false,
                lastQuizId: null,
                // 模式 3 單字卡執行期狀態
                fcWord: null,
                fcFlipped: false,
                lastFcId: null,
                fcTransitioning: false,
                // 模式 4 不熟複習執行期狀態
                m4Submode: 'list',        // 'list' | 'cards' | 'quiz'
                m4MaskZh: false,
                m4MaskEn: false,
                m4Search: '',
                m4Sort: 'newest',         // 'newest' | 'struggle' | 'id'
                m4JustCelebrated: false,  // 當在模式 4 清空最後一個不熟字時觸發慶祝畫面
                // 模式 4-2 單字卡
                m4FcWord: null,
                m4FcFlipped: false,
                m4LastFcId: null,
                m4FcTransitioning: false,
                // 模式 4-3 小測驗
                m4QuizType: 'en2zh',      // 'en2zh' | 'zh2en'
                m4QuizWord: null,
                m4QuizOptions: [],
                m4QuizAnswered: false,
                m4LastQuizId: null,
                // 全部單字表 Modal
                allFilter: 'all',
                allSearch: '',
                // 復原 (Undo) 暫存
                undoAction: null
            };

            function loadState() {
                try {
                    const savedV2 = localStorage.getItem(STORAGE_KEY_V2);
                    if (savedV2) {
                        const p = JSON.parse(savedV2);
                        if (p.wordData && typeof p.wordData === 'object') state.wordData = p.wordData;
                        if (p.stats) {
                            state.stats = {
                                total: Number(p.stats.total) || 0,
                                correct: Number(p.stats.correct) || 0,
                                streak: Number(p.stats.streak) || 0
                            };
                        }
                        if (p.theme === 'dark' || p.theme === 'light') state.theme = p.theme;
                        if (typeof p.autoAddWrong === 'boolean') state.autoAddWrong = p.autoAddWrong;
                        if (typeof p.autoSpeakMode2 === 'boolean') state.autoSpeakMode2 = p.autoSpeakMode2;
                        if (['mode1', 'mode2', 'mode3', 'mode4'].includes(p.mode)) state.mode = p.mode;
                        if (['all', '1-100', '101-200', '201-300', '301-400', '401-450'].includes(p.range)) state.range = p.range;
                        return;
                    }

                    // 嘗試遷移舊版 v1 資料
                    const savedV1 = localStorage.getItem(STORAGE_KEY_V1);
                    if (savedV1) {
                        const old = JSON.parse(savedV1);
                        if (old.wordStatus && typeof old.wordStatus === 'object') {
                            const now = Date.now();
                            Object.keys(old.wordStatus).forEach(k => {
                                const id = parseInt(k, 10);
                                const st = old.wordStatus[k];
                                if (st === 'learning') {
                                    state.wordData[id] = { status: 'unlearned', struggleCount: 1, updatedAt: now };
                                } else if (st === 'mastered') {
                                    state.wordData[id] = { status: 'learned', struggleCount: 0, updatedAt: now };
                                }
                            });
                        }
                        if (old.theme === 'dark' || old.theme === 'light') state.theme = old.theme;
                        saveState();
                        return;
                    }

                    // 預設依照系統淺色/深色（若系統無偏好預設暖象牙淺色）
                    if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                        state.theme = 'light'; // 依規範 Light Mode 為預設
                    }
                } catch (err) {
                    console.warn('讀取本機進度失敗:', err);
                }
            }

            function saveState() {
                try {
                    localStorage.setItem(STORAGE_KEY_V2, JSON.stringify({
                        v: 2,
                        wordData: state.wordData,
                        stats: state.stats,
                        theme: state.theme,
                        autoAddWrong: state.autoAddWrong,
                        autoSpeakMode2: state.autoSpeakMode2,
                        mode: state.mode,
                        range: state.range
                    }));
                } catch (err) {
                    console.warn('儲存本機進度失敗:', err);
                }
            }

            /* =========================================================================
             * 3. 單字狀態讀寫與不熟清單查詢
             * ========================================================================= */
            function getWordRecord(id) {
                return state.wordData[id] || { status: 'unmarked', struggleCount: 0, updatedAt: 0 };
            }

            function getWordStatus(id) {
                return state.wordData[id] ? state.wordData[id].status : 'unmarked';
            }

            /**
             * 標記單字為「還沒學會」：記錄時間戳並累加 struggleCount
             */
            function markWordUnlearned(id, incrementStruggle = true) {
                const prev = getWordRecord(id);
                const nextCount = incrementStruggle ? (prev.struggleCount || 0) + 1 : Math.max(1, prev.struggleCount || 1);
                state.wordData[id] = {
                    status: 'unlearned',
                    struggleCount: nextCount,
                    updatedAt: Date.now()
                };
                state.m4JustCelebrated = false;
                saveState();
                updateGlobalCounters();
            }

            /**
             * 標記單字為「學會了」：保留原 struggleCount 方便復原
             */
            function markWordLearned(id) {
                const prev = getWordRecord(id);
                state.wordData[id] = {
                    status: 'learned',
                    struggleCount: prev.struggleCount || 0,
                    updatedAt: Date.now()
                };
                saveState();
                updateGlobalCounters();
            }

            function clearWordStatus(id) {
                delete state.wordData[id];
                saveState();
                updateGlobalCounters();
            }

            function getUnlearnedWords() {
                return VOCAB_LIST.filter(w => getWordStatus(w.id) === 'unlearned');
            }

            function getRangePool() {
                switch (state.range) {
                    case '1-100':   return VOCAB_LIST.filter(w => w.id >= 1 && w.id <= 100);
                    case '101-200': return VOCAB_LIST.filter(w => w.id >= 101 && w.id <= 200);
                    case '201-300': return VOCAB_LIST.filter(w => w.id >= 201 && w.id <= 300);
                    case '301-400': return VOCAB_LIST.filter(w => w.id >= 301 && w.id <= 400);
                    case '401-450': return VOCAB_LIST.filter(w => w.id >= 401 && w.id <= 450);
                    default:        return VOCAB_LIST;
                }
            }

            /* =========================================================================
             * 4. 語音朗讀 (Web Speech API) 與答題音效 (Web Audio API)
             * ========================================================================= */
            let audioCtx = null;

            function playTone(isCorrect) {
                try {
                    const AC = window.AudioContext || window.webkitAudioContext;
                    if (!AC) return;
                    if (!audioCtx) audioCtx = new AC();
                    if (audioCtx.state === 'suspended') audioCtx.resume();

                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);

                    const now = audioCtx.currentTime;
                    if (isCorrect) {
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(587.33, now);
                        osc.frequency.exponentialRampToValueAtTime(880, now + 0.11);
                        gain.gain.setValueAtTime(0.075, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.21);
                        osc.start(now);
                        osc.stop(now + 0.22);
                    } else {
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(240, now);
                        osc.frequency.exponentialRampToValueAtTime(175, now + 0.17);
                        gain.gain.setValueAtTime(0.075, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
                        osc.start(now);
                        osc.stop(now + 0.23);
                    }
                } catch (e) { /* 忽略無音訊裝置 */ }
            }

            function speakWord(rawText) {
                if (!('speechSynthesis' in window)) {
                    showToast('此瀏覽器不支援語音朗讀');
                    return;
                }
                try {
                    window.speechSynthesis.cancel();
                    const cleanText = rawText
                        .replace(/\bsb\/sth\b/gi, 'somebody or something')
                        .replace(/\bsth\b/gi, 'something')
                        .replace(/\bsb\b/gi, 'somebody')
                        .replace(/\//g, ' or ');

                    const utter = new SpeechSynthesisUtterance(cleanText);
                    utter.lang = 'en-US';
                    utter.rate = 0.92;
                    utter.pitch = 1.0;

                    const voices = window.speechSynthesis.getVoices();
                    const usVoice = voices.find(v => v.lang === 'en-US' && /Samantha|Alex|Google|Natural|Aaron/i.test(v.name))
                                 || voices.find(v => v.lang === 'en-US')
                                 || voices.find(v => v.lang.startsWith('en'));
                    if (usVoice) utter.voice = usVoice;

                    window.speechSynthesis.speak(utter);
                } catch (e) {
                    showToast('語音播放失敗，請再試一次');
                }
            }

            /* =========================================================================
             * 5. 抽題演算法、去重干擾項與通用工具
             * ========================================================================= */
            function formatId(id) {
                return '#' + String(id).padStart(3, '0');
            }

            function escapeHtml(str) {
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            /**
             * 智慧權重隨機抽字（用於模式 1–3）
             * unlearned = 8, unmarked = 3, learned = 0.5
             */
            function pickWeightedWord(pool, excludeId) {
                if (!pool || pool.length === 0) return null;
                if (pool.length === 1) return pool[0];

                const candidates = pool.filter(w => w.id !== excludeId);
                const list = candidates.length > 0 ? candidates : pool;

                let totalWeight = 0;
                const wts = list.map(w => {
                    const st = getWordStatus(w.id);
                    const wt = WEIGHTS[st] || WEIGHTS.unmarked;
                    totalWeight += wt;
                    return wt;
                });

                let r = Math.random() * totalWeight;
                for (let i = 0; i < list.length; i++) {
                    r -= wts[i];
                    if (r <= 0) return list[i];
                }
                return list[list.length - 1];
            }

            /**
             * 不熟專攻抽字（依照不熟次數給予略高權重，並避免連續抽到同字）
             */
            function pickFocusedUnlearnedWord(unlearnedPool, excludeId) {
                if (!unlearnedPool || unlearnedPool.length === 0) return null;
                if (unlearnedPool.length === 1) return unlearnedPool[0];

                const candidates = unlearnedPool.filter(w => w.id !== excludeId);
                const list = candidates.length > 0 ? candidates : unlearnedPool;

                let totalWeight = 0;
                const wts = list.map(w => {
                    const rec = getWordRecord(w.id);
                    const wt = Math.min(10, 1 + (rec.struggleCount || 1));
                    totalWeight += wt;
                    return wt;
                });

                let r = Math.random() * totalWeight;
                for (let i = 0; i < list.length; i++) {
                    r -= wts[i];
                    if (r <= 0) return list[i];
                }
                return list[list.length - 1];
            }

            /**
             * 產生 4 個不重複選項（干擾項一律從完整 450 字庫抽取，確保即便不熟清單僅 1 字仍可測驗）
             */
            function generateOptions(targetWord) {
                const usedEn = new Set([targetWord.en.toLowerCase()]);
                const usedZh = new Set([targetWord.zh]);
                const options = [targetWord];

                let tries = 0;
                while (options.length < 4 && tries < 250) {
                    tries++;
                    const cand = VOCAB_LIST[Math.floor(Math.random() * VOCAB_LIST.length)];
                    const enKey = cand.en.toLowerCase();
                    if (!usedEn.has(enKey) && !usedZh.has(cand.zh)) {
                        usedEn.add(enKey);
                        usedZh.add(cand.zh);
                        options.push(cand);
                    }
                }

                for (let i = options.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [options[i], options[j]] = [options[j], options[i]];
                }
                return options;
            }

            let toastTimer = null;
            function showToast(msg, undoCallback = null) {
                const container = document.getElementById('toastContainer');
                const textEl = document.getElementById('toastMessage');
                const undoBtn = document.getElementById('btnToastUndo');

                textEl.textContent = msg;
                state.undoAction = undoCallback;

                if (undoCallback) {
                    undoBtn.classList.remove('hidden');
                    container.classList.remove('pointer-events-none');
                } else {
                    undoBtn.classList.add('hidden');
                    container.classList.add('pointer-events-none');
                }

                container.classList.remove('opacity-0', '-translate-y-2');
                container.classList.add('opacity-100', 'translate-y-0');

                clearTimeout(toastTimer);
                toastTimer = setTimeout(hideToast, undoCallback ? 4200 : 2300);
            }

            function hideToast() {
                const container = document.getElementById('toastContainer');
                container.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
                container.classList.remove('opacity-100', 'translate-y-0');
                state.undoAction = null;
