            function populateMode3Card(word) {
                const st = getWordStatus(word.id);
                const rec = getWordRecord(word.id);
                document.getElementById('fcFrontId').textContent = formatId(word.id);
                document.getElementById('fcBackId').textContent = formatId(word.id);
                document.getElementById('fcEnglishWord').textContent = word.en;
                document.getElementById('fcBackEnRef').textContent = word.en;
                document.getElementById('fcChineseMeaning').textContent = word.zh;

                renderStatusPill(document.getElementById('fcFrontStatus'), st);

                const hint = document.getElementById('fcFrontWeightHint');
                if (st === 'unlearned') hint.textContent = `高頻複習中（已標記 ${Math.max(1, rec.struggleCount)} 次）`;
                else if (st === 'learned') hint.textContent = '低頻複習';
