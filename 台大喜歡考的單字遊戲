            /* =========================================================================
             * 6. 頂部進度、主題、模式切換 UI 更新
             * ========================================================================= */
            function applyTheme() {
                const isDark = state.theme === 'dark';
                document.documentElement.classList.toggle('dark', isDark);
                const metaTheme = document.getElementById('metaThemeColor');
                if (metaTheme) metaTheme.setAttribute('content', isDark ? '#020617' : '#FAF8F5');
            }

            function updateGlobalCounters() {
                let learned = 0;
                let unlearned = 0;
                for (const w of VOCAB_LIST) {
                    const st = getWordStatus(w.id);
                    if (st === 'learned') learned++;
                    else if (st === 'unlearned') unlearned++;
                }

                const total = VOCAB_LIST.length;
                document.getElementById('hdrLearned').textContent = learned;
                document.getElementById('hdrUnlearned').textContent = unlearned;
                document.getElementById('barLearned').style.width = `${(learned / total) * 100}%`;
                document.getElementById('barUnlearned').style.width = `${(unlearned / total) * 100}%`;

                // 模式 4 導覽列紅橘色即時徽章
                const badge = document.getElementById('badgeUnlearnedCount');
                badge.textContent = unlearned;
                if (unlearned > 0) {
                    badge.classList.remove('bg-slate-300', 'dark:bg-slate-700', 'text-slate-600', 'dark:text-slate-300');
                    badge.classList.add('bg-gradient-to-r', 'from-orange-500', 'to-rose-500', 'text-white');
                } else {
                    badge.classList.add('bg-slate-300', 'dark:bg-slate-700', 'text-slate-600', 'dark:text-slate-300');
                    badge.classList.remove('bg-gradient-to-r', 'from-orange-500', 'to-rose-500', 'text-white');
                }

                // 模式 4 內部標題計數
                document.getElementById('m4HeaderCountPill').textContent = `${unlearned} 個待複習`;

                // 測驗統計
                document.getElementById('statScore').textContent = `${state.stats.correct} / ${state.stats.total}`;
                const acc = state.stats.total > 0 ? Math.round((state.stats.correct / state.stats.total) * 100) : null;
                document.getElementById('statAccuracy').textContent = acc !== null ? `${acc}%` : '--%';
                document.getElementById('statStreak').textContent = state.stats.streak >= 2 ? `🔥 ${state.stats.streak}` : state.stats.streak;
            }

