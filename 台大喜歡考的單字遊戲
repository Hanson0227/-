                const rec = getWordRecord(word.id);
                const count = Math.max(1, rec.struggleCount || 1);
                document.getElementById('m4CardRemainText').textContent = `剩餘 ${getUnlearnedWords().length} 個不熟單字`;
                document.getElementById('m4FcFrontId').textContent = formatId(word.id);
                document.getElementById('m4FcBackId').textContent = formatId(word.id);
                document.getElementById('m4FcStruggleBadge').textContent = `標記 ${count} 次`;
                document.getElementById('m4FcEnglishWord').textContent = word.en;
                document.getElementById('m4FcBackEnRef').textContent = word.en;
                document.getElementById('m4FcChineseMeaning').textContent = word.zh;
            }

            function loadNextM4Flashcard(animateDir) {
                const pool = getUnlearnedWords();
                if (pool.length === 0) {
                    renderMode4();
                    return;
                }

                const nextWord = pickFocusedUnlearnedWord(pool, state.m4LastFcId);
                const stage = document.getElementById('m4FcStage');
                const inner = document.getElementById('m4FcInner');

                if (!animateDir) {
                    state.m4FcWord = nextWord;
                    state.m4LastFcId = nextWord.id;
                    state.m4FcFlipped = false;
                    inner.classList.remove('is-flipped');
                    populateM4Card(nextWord);
                    return;
                }

                if (state.m4FcTransitioning) return;
                state.m4FcTransitioning = true;

                const exitCls = animateDir === 'left' ? 'card-exit-left' : 'card-exit-right';
                stage.classList.add(exitCls);

                setTimeout(() => {
                    inner.style.transition = 'none';
                    inner.classList.remove('is-flipped');
                    state.m4FcFlipped = false;
                    state.m4FcWord = nextWord;
                    state.m4LastFcId = nextWord.id;
                    populateM4Card(nextWord);

                    void inner.offsetWidth;
                    inner.style.transition = '';

                    stage.classList.remove(exitCls);
                    stage.classList.add('card-enter');
                    void stage.offsetWidth;
                    stage.classList.remove('card-enter');

                    setTimeout(() => { state.m4FcTransitioning = false; }, 180);
                }, 220);
            }

            function toggleM4CardFlip() {
                if (state.m4FcTransitioning || !state.m4FcWord) return;
                state.m4FcFlipped = !state.m4FcFlipped;
                document.getElementById('m4FcInner').classList.toggle('is-flipped', state.m4FcFlipped);
            }

            function handleM4CardDecision(isMastered) {
                if (!state.m4FcWord || state.m4FcTransitioning) return;
                const word = state.m4FcWord;

                if (isMastered) {
                    const prevSnapshot = { ...getWordRecord(word.id) };
                    markWordLearned(word.id);
                    playTone(true);

                    const remaining = getUnlearnedWords().length;
                    if (remaining === 0) {
                        state.m4JustCelebrated = true;
                        showToast(`「${word.en}」已移出不熟清單`, () => {
                            state.wordData[word.id] = {
                                status: 'unlearned',
                                struggleCount: Math.max(1, prevSnapshot.struggleCount || 1),
                                updatedAt: prevSnapshot.updatedAt || Date.now()
                            };
                            state.m4JustCelebrated = false;
                            saveState();
                            updateGlobalCounters();
                            renderMode4();
                        });
                        renderMode4();
                        return;
                    }

                    showToast(`「${word.en}」已學會！剩餘 ${remaining} 個`, () => {
                        state.wordData[word.id] = {
                            status: 'unlearned',
                            struggleCount: Math.max(1, prevSnapshot.struggleCount || 1),
                            updatedAt: prevSnapshot.updatedAt || Date.now()
                        };
                        saveState();
                        updateGlobalCounters();
                        if (state.mode === 'mode4' && state.m4Submode === 'cards') {
                            document.getElementById('m4CardRemainText').textContent = `剩餘 ${getUnlearnedWords().length} 個不熟單字`;
                        }
                    });
                    loadNextM4Flashcard('right');
                } else {
                    markWordUnlearned(word.id, true);
                    loadNextM4Flashcard('left');
                }
            }

