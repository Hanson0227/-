                const wrapSpeakM2 = document.getElementById('wrapAutoSpeakMode2');
                const quizSec = document.getElementById('quizSection');
                const fcSec = document.getElementById('flashcardSection');
                const revSec = document.getElementById('reviewSection');

                quizSec.classList.add('hidden');
                fcSec.classList.add('hidden');
                revSec.classList.add('hidden');

                if (state.mode === 'mode1' || state.mode === 'mode2') {
                    sharedBar.classList.remove('hidden');
                    quizPrefs.classList.remove('hidden');
                    wrapSpeakM2.classList.toggle('hidden', state.mode !== 'mode2');
                    quizSec.classList.remove('hidden');
                    loadNextQuizQuestion();
                } else if (state.mode === 'mode3') {
                    sharedBar.classList.remove('hidden');
                    quizPrefs.classList.add('hidden');
                    fcSec.classList.remove('hidden');
                    loadNextFlashcard(false);
                } else if (state.mode === 'mode4') {
                    sharedBar.classList.add('hidden');
                    revSec.classList.remove('hidden');
                    renderMode4();
                }

                updateFixedBottomBar();
            }

            /* =========================================================================
             * 7. 模式 1（英選中）與 模式 2（中選英）邏輯
             * ========================================================================= */
            function loadNextQuizQuestion() {
                const pool = getRangePool();
                const word = pickWeightedWord(pool, state.lastQuizId);
                if (!word) return;

                state.quizWord = word;
                state.lastQuizId = word.id;
                state.quizOptions = generateOptions(word);
                state.quizAnswered = false;

                const isMode1 = state.mode === 'mode1';

                document.getElementById('quizWordId').textContent = formatId(word.id);
                renderStatusPill(document.getElementById('quizWordStatus'), getWordStatus(word.id));

                const promptEl = document.getElementById('quizPromptText');
                const speakBtn = document.getElementById('btnQuizSpeak');
                const revealEl = document.getElementById('mode2AnswerReveal');
                const hintEl = document.getElementById('quizModeHint');

                revealEl.classList.add('hidden');
                document.getElementById('quizFeedbackBar').classList.add('hidden');

                if (isMode1) {
                    hintEl.textContent = '請選出對應的中文解釋';
                    promptEl.textContent = word.en;
                    promptEl.className = 'text-3xl sm:text-4xl md:text-5xl font-extrabold text-academy-900 dark:text-white tracking-tight break-words max-w-full';
                    speakBtn.classList.remove('hidden');
                } else {
                    hintEl.textContent = '請選出對應的英文單字';
                    promptEl.textContent = word.zh;
                    promptEl.className = 'text-xl sm:text-2xl md:text-3xl font-bold text-academy-900 dark:text-white leading-snug break-words max-w-2xl';
                    speakBtn.classList.add('hidden');
                }

                renderOptionButtons(
                    document.getElementById('quizOptionsGrid'),
                    state.quizOptions,
                    isMode1 ? 'en2zh' : 'zh2en',
                    handleQuizAnswer
                );
            }

            function renderOptionButtons(container, options, type, onSelect) {
                const labels = ['A', 'B', 'C', 'D'];
                container.innerHTML = '';

                options.forEach((opt, idx) => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'quiz-opt-btn group w-full text-left p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border-2 border-slate-200/90 dark:border-slate-800 hover:border-indigo-400 dark:hover:border-indigo-500 hover:bg-indigo-50/40 dark:hover:bg-indigo-950/30 shadow-sm transition-all duration-150 flex items-center gap-3.5 active:scale-[0.99]';

                    const labelText = type === 'en2zh' ? opt.zh : opt.en;
                    const textCls = type === 'en2zh'
                        ? 'text-sm sm:text-base font-medium text-slate-700 dark:text-slate-200 leading-snug'
                        : 'text-lg sm:text-xl font-bold text-slate-800 dark:text-slate-100 tracking-tight';

                    btn.innerHTML = `
                        <span class="opt-letter w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-800 group-hover:bg-indigo-600 group-hover:text-white text-slate-600 dark:text-slate-300 font-extrabold text-sm flex items-center justify-center shrink-0 transition-colors">
                            ${labels[idx]}
                        </span>
                        <span class="${textCls} flex-1 break-words">${escapeHtml(labelText)}</span>
                    `;
                    btn.addEventListener('click', () => onSelect(idx));
                    container.appendChild(btn);
                });
            }

            function highlightOptionResults(container, options, targetId, selectedIndex, isCorrect) {
                const btns = container.querySelectorAll('.quiz-opt-btn');
                btns.forEach((btn, idx) => {
                    btn.disabled = true;
                    btn.classList.remove('hover:border-indigo-400', 'dark:hover:border-indigo-500', 'hover:bg-indigo-50/40', 'dark:hover:bg-indigo-950/30');
                    const letter = btn.querySelector('.opt-letter');
                    const opt = options[idx];

                    if (opt.id === targetId) {
                        btn.classList.remove('border-slate-200/90', 'dark:border-slate-800', 'bg-white', 'dark:bg-slate-900');
                        btn.classList.add('border-emerald-500', 'bg-emerald-50', 'dark:bg-emerald-950/50', 'animate-pop');
                        letter.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
                        letter.classList.add('bg-emerald-500', 'text-white');
                    } else if (idx === selectedIndex && !isCorrect) {
                        btn.classList.remove('border-slate-200/90', 'dark:border-slate-800', 'bg-white', 'dark:bg-slate-900');
                        btn.classList.add('border-rose-500', 'bg-rose-50', 'dark:bg-rose-950/50', 'animate-shake');
                        letter.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
                        letter.classList.add('bg-rose-500', 'text-white');
                    } else {
                        btn.classList.add('opacity-50');
                    }
                });
            }

            function handleQuizAnswer(selectedIndex) {
                if (state.quizAnswered || !state.quizWord) return;
                state.quizAnswered = true;

                const target = state.quizWord;
                const chosen = state.quizOptions[selectedIndex];
                const isCorrect = chosen.id === target.id;

                state.stats.total++;
                if (isCorrect) {
                    state.stats.correct++;
                    state.stats.streak++;
                } else {
                    state.stats.streak = 0;
                    if (state.autoAddWrong) {
                        markWordUnlearned(target.id, true);
                    }
                }
                saveState();
                updateGlobalCounters();
                playTone(isCorrect);

                highlightOptionResults(
                    document.getElementById('quizOptionsGrid'),
                    state.quizOptions,
                    target.id,
                    selectedIndex,
                    isCorrect
                );

                // 模式 2 答後發音顯示與自動朗讀
                if (state.mode === 'mode2') {
                    document.getElementById('mode2AnswerWordText').textContent = target.en;
                    document.getElementById('mode2AnswerReveal').classList.remove('hidden');
                    if (state.autoSpeakMode2) {
                        setTimeout(() => speakWord(target.en), 220);
                    }
                }

                renderStatusPill(document.getElementById('quizWordStatus'), getWordStatus(target.id));

                // 顯示下方回饋列
                const bar = document.getElementById('quizFeedbackBar');
                const icon = document.getElementById('feedbackIcon');
                const title = document.getElementById('feedbackTitle');
                const sub = document.getElementById('feedbackSubtitle');

                bar.className = 'rounded-2xl p-4 border transition-all duration-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3';
                if (isCorrect) {
                    bar.classList.add('bg-emerald-50', 'dark:bg-emerald-950/40', 'border-emerald-200', 'dark:border-emerald-800', 'text-emerald-900', 'dark:text-emerald-100');
                    icon.className = 'w-8 h-8 rounded-full flex items-center justify-center shrink-0 mt-0.5 bg-emerald-500 text-white';
                    icon.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>';
                    title.textContent = state.stats.streak >= 3 ? `答對了！連續答對 ${state.stats.streak} 題！` : '答對了！';
                    sub.textContent = `${target.en} — ${target.zh}`;
                } else {
                    bar.classList.add('bg-rose-50', 'dark:bg-rose-950/40', 'border-rose-200', 'dark:border-rose-800', 'text-rose-900', 'dark:text-rose-100');
                    icon.className = 'w-8 h-8 rounded-full flex items-center justify-center shrink-0 mt-0.5 bg-rose-500 text-white';
                    icon.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>';
                    title.textContent = state.autoAddWrong ? '答錯了！已自動加入「模式 4 不熟複習」' : '答錯了！';
                    sub.textContent = `正確答案：${target.en}（${target.zh}）`;
                }

                updateQuizMarkButton(target.id);
            }

