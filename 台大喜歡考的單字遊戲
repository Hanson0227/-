<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <!-- iPad / iPhone 觸控與主畫面全螢幕 PWA 設定 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="台大450單字">
    <meta name="theme-color" content="#FAF8F5" id="metaThemeColor">
    <title>台大 450 單字互動學習</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & Noto Sans TC -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', '"Noto Sans TC"', 'system-ui', '-apple-system', 'sans-serif'],
                    },
                    colors: {
                        ivory: '#FAF8F5',
                        academy: {
                            50: '#EEF2FF',
                            100: '#E0E7FF',
                            600: '#3730A3',
                            700: '#2E2A72',
                            800: '#1E2952',
                            900: '#131A36',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* ==================== 基礎設定與 iPad 安全區域 ==================== */
        :root {
            --sat: env(safe-area-inset-top, 0px);
            --sab: env(safe-area-inset-bottom, 0px);
            --sal: env(safe-area-inset-left, 0px);
            --sar: env(safe-area-inset-right, 0px);
        }

        body {
            font-family: 'Inter', 'Noto Sans TC', system-ui, -apple-system, sans-serif;
            -webkit-tap-highlight-color: transparent;
            overscroll-behavior-y: none;
        }

        .safe-header {
            padding-top: var(--sat);
        }

        .safe-bottom-bar {
            padding-bottom: calc(1rem + var(--sab));
            padding-left: calc(1rem + var(--sal));
            padding-right: calc(1rem + var(--sar));
        }

        /* 細緻紙感點狀背景 */
        .notebook-bg {
            background-image: radial-gradient(rgba(30, 41, 82, 0.055) 1px, transparent 1px);
            background-size: 22px 22px;
        }
        .dark .notebook-bg {
            background-image: radial-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px);
            background-size: 22px 22px;
        }

        /* ==================== 3D 單字卡翻面效果 ==================== */
        .perspective-1200 {
            perspective: 1200px;
        }

        .flashcard-inner {
            position: relative;
            width: 100%;
            height: 100%;
            transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
            transform-style: preserve-3d;
        }

        .flashcard-inner.is-flipped {
            transform: rotateY(180deg);
        }

        .flashcard-face {
            position: absolute;
            inset: 0;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
        }

        .flashcard-back {
            transform: rotateY(180deg);
        }

        /* 卡片滑出與進場過場 */
        .card-stage {
            transition: transform 0.24s ease, opacity 0.24s ease;
        }
        .card-exit-left {
            transform: translateX(-36px) rotate(-2deg);
            opacity: 0;
        }
        .card-exit-right {
            transform: translateX(36px) rotate(2deg);
            opacity: 0;
        }
        .card-enter {
            transform: scale(0.96) translateY(8px);
            opacity: 0;
        }

        /* ==================== 自我檢測遮罩效果 ==================== */
        .mask-box {
            position: relative;
            display: inline-block;
            border-radius: 0.65rem;
            cursor: pointer;
            transition: all 0.22s ease;
        }
        .mask-box.is-masked {
            background: rgba(148, 163, 184, 0.2);
            padding: 0.15rem 0.55rem;
            user-select: none;
        }
        .dark .mask-box.is-masked {
            background: rgba(51, 65, 85, 0.75);
        }
        .mask-box.is-masked > .mask-content {
            filter: blur(7px);
            opacity: 0.22;
            transition: filter 0.22s ease, opacity 0.22s ease;
        }
        .mask-box.is-masked::after {
            content: '點擊顯示';
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            color: #4f46e5;
            pointer-events: none;
        }
        .dark .mask-box.is-masked::after {
            color: #a5b4fc;
        }
        .mask-box:not(.is-masked) > .mask-content {
            filter: blur(0);
            opacity: 1;
            transition: filter 0.22s ease, opacity 0.22s ease;
        }

        /* ==================== 微動畫與捲軸 ==================== */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-5px); }
            40% { transform: translateX(5px); }
            60% { transform: translateX(-4px); }
            80% { transform: translateX(4px); }
        }
        .animate-shake {
            animation: shake 0.34s ease-in-out;
        }

        @keyframes pop {
            0% { transform: scale(1); }
            50% { transform: scale(1.025); }
            100% { transform: scale(1); }
        }
        .animate-pop {
            animation: pop 0.26s ease-out;
        }

        /* 自訂輕量捲軸 */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, 0.45);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(100, 116, 139, 0.7);
        }
    </style>
</head>
<body class="bg-ivory dark:bg-slate-950 text-slate-800 dark:text-slate-100 notebook-bg min-h-screen transition-colors duration-300 selection:bg-indigo-200 dark:selection:bg-indigo-800">

    <!-- ==================== 頂部導覽列 ==================== -->
    <header class="safe-header sticky top-0 z-40 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800 shadow-sm">
        <div class="max-w-4xl mx-auto px-3 sm:px-6 py-2.5 sm:py-3">
            <div class="flex items-center justify-between gap-2">
                <!-- 品牌標題與即時總覽 -->
                <div class="flex items-center gap-2.5 min-w-0">
                    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-academy-800 to-indigo-600 text-white flex items-center justify-center shadow-md shrink-0 font-extrabold text-xs sm:text-sm tracking-tight">
                        NTU
                    </div>
                    <div class="min-w-0">
                        <h1 class="text-sm sm:text-lg font-extrabold text-academy-900 dark:text-white truncate">
                            台大 450 單字互動學習
                        </h1>
                        <div class="flex items-center gap-2 text-[11px] sm:text-xs font-medium text-slate-500 dark:text-slate-400">
                            <span class="text-emerald-600 dark:text-emerald-400">已學會 <strong id="hdrLearned" class="font-bold">0</strong></span>
                            <span class="text-slate-300 dark:text-slate-600">|</span>
                            <span class="text-orange-600 dark:text-orange-400">還沒學會 <strong id="hdrUnlearned" class="font-bold">0</strong></span>
                            <span class="text-slate-300 dark:text-slate-600 hidden xs:inline">|</span>
                            <span class="hidden xs:inline">總計 450</span>
                        </div>
                    </div>
                </div>

                <!-- 頂部功能按鈕群 -->
                <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
                    <!-- 全部單字表 -->
                    <button id="btnOpenAllWords" type="button" class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-indigo-50 hover:bg-indigo-100 dark:bg-indigo-950/70 dark:hover:bg-indigo-900/80 text-indigo-700 dark:text-indigo-300 border border-indigo-200/70 dark:border-indigo-800/70 transition active:scale-95" title="開啟全部單字表">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                        <span class="hidden md:inline">全部單字表</span>
                    </button>

                    <!-- 備份 / 還原進度 -->
                    <button id="btnOpenBackup" type="button" class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition active:scale-95" title="備份或還原學習進度">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                        <span class="hidden md:inline">備份/還原</span>
                    </button>

                    <!-- 深淺色切換 -->
                    <button id="btnToggleTheme" type="button" class="p-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-amber-300 border border-slate-200 dark:border-slate-700 transition active:scale-95" title="切換深淺色主題" aria-label="切換深淺色主題">
                        <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                        <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
                    </button>
                </div>
            </div>

            <!-- 細長進度條 -->
            <div class="mt-2.5 w-full h-1.5 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden flex">
                <div id="barLearned" class="bg-emerald-500 transition-all duration-500 h-full" style="width: 0%"></div>
                <div id="barUnlearned" class="bg-orange-500 transition-all duration-500 h-full" style="width: 0%"></div>
            </div>
        </div>
    </header>

    <!-- ==================== 主操作容器 ==================== -->
    <main class="max-w-4xl mx-auto px-3 sm:px-6 pt-4 pb-12">

        <!-- 四大模式導覽列 -->
        <nav class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 sm:gap-2 p-1.5 bg-slate-200/75 dark:bg-slate-800/80 rounded-2xl mb-4" role="tablist" aria-label="學習模式切換">
            <button data-mode="mode1" type="button" class="mode-tab flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200">
                <span class="px-1.5 py-0.5 rounded-md text-[10px] sm:text-xs bg-indigo-100 dark:bg-indigo-900/70 text-indigo-700 dark:text-indigo-300 shrink-0">模式 1</span>
                <span class="truncate">英選中</span>
            </button>
            <button data-mode="mode2" type="button" class="mode-tab flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200">
                <span class="px-1.5 py-0.5 rounded-md text-[10px] sm:text-xs bg-indigo-100 dark:bg-indigo-900/70 text-indigo-700 dark:text-indigo-300 shrink-0">模式 2</span>
                <span class="truncate">中選英</span>
            </button>
            <button data-mode="mode3" type="button" class="mode-tab flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200">
                <span class="px-1.5 py-0.5 rounded-md text-[10px] sm:text-xs bg-indigo-100 dark:bg-indigo-900/70 text-indigo-700 dark:text-indigo-300 shrink-0">模式 3</span>
                <span class="truncate">單字卡</span>
            </button>
            <button data-mode="mode4" type="button" class="mode-tab relative flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200">
                <span class="px-1.5 py-0.5 rounded-md text-[10px] sm:text-xs bg-orange-100 dark:bg-orange-950 text-orange-700 dark:text-orange-300 shrink-0">模式 4</span>
                <span class="truncate">不熟複習</span>
                <!-- 即時紅橘色不熟計數徽章 -->
                <span id="badgeUnlearnedCount" class="inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 rounded-full text-[11px] font-extrabold bg-gradient-to-r from-orange-500 to-rose-500 text-white shadow-sm">
                    0
                </span>
            </button>
        </nav>

        <!-- ==================== 模式 1–3 共用控制列（範圍篩選 + 測驗偏好） ==================== -->
        <section id="sharedControlsBar" class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200/90 dark:border-slate-800 p-3 sm:p-3.5 mb-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-2.5">
                <!-- 範圍篩選膠囊列 -->
                <div class="flex items-center gap-1.5 overflow-x-auto pb-0.5 md:pb-0 no-scrollbar">
                    <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 shrink-0 mr-1">範圍：</span>
                    <button data-range="all" type="button" class="range-pill px-2.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition">全部 (1-450)</button>
                    <button data-range="1-100" type="button" class="range-pill px-2.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition">1-100</button>
                    <button data-range="101-200" type="button" class="range-pill px-2.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition">101-200</button>
                    <button data-range="201-300" type="button" class="range-pill px-2.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition">201-300</button>
                    <button data-range="301-400" type="button" class="range-pill px-2.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition">301-400</button>
                    <button data-range="401-450" type="button" class="range-pill px-2.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition">401-450</button>
                </div>

                <!-- 測驗模式專屬開關（模式 1 & 2 顯示） -->
                <div id="quizPrefsRow" class="flex flex-wrap items-center gap-3 pt-2 md:pt-0 border-t md:border-t-0 border-slate-100 dark:border-slate-800 shrink-0">
                    <label class="inline-flex items-center gap-2 cursor-pointer select-none">
                        <input id="toggleAutoAddWrong" type="checkbox" class="w-4 h-4 rounded text-orange-600 focus:ring-orange-500 border-slate-300 dark:border-slate-600 dark:bg-slate-800 cursor-pointer">
                        <span class="text-xs font-medium text-slate-600 dark:text-slate-300">答錯自動加入不熟清單</span>
                    </label>
                    <label id="wrapAutoSpeakMode2" class="hidden inline-flex items-center gap-2 cursor-pointer select-none">
                        <input id="toggleAutoSpeakMode2" type="checkbox" class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300 dark:border-slate-600 dark:bg-slate-800 cursor-pointer">
                        <span class="text-xs font-medium text-slate-600 dark:text-slate-300">答後自動朗讀</span>
                    </label>
                </div>
            </div>
        </section>

        <!-- ==================== 模式 1 & 模式 2：測驗區 ==================== -->
        <section id="quizSection" class="hidden">
            <!-- 測驗數據列 -->
            <div class="flex flex-wrap items-center justify-between gap-2 bg-white/85 dark:bg-slate-900/85 border border-slate-200/80 dark:border-slate-800 rounded-2xl px-4 py-2.5 mb-4 text-xs sm:text-sm">
                <div class="flex items-center gap-4 sm:gap-5">
                    <div class="flex items-center gap-1.5">
                        <span class="text-slate-500 dark:text-slate-400">得分</span>
                        <span id="statScore" class="font-bold text-slate-800 dark:text-white">0 / 0</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="text-slate-500 dark:text-slate-400">答對率</span>
                        <span id="statAccuracy" class="font-bold text-indigo-600 dark:text-indigo-400">--%</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="text-slate-500 dark:text-slate-400">連勝</span>
                        <span id="statStreak" class="font-extrabold text-amber-600 dark:text-amber-400">0</span>
                    </div>
                </div>
                <div class="hidden sm:flex items-center gap-1.5 text-xs text-slate-400 dark:text-slate-500">
                    <span>快捷鍵：</span>
                    <kbd class="px-1.5 py-0.5 bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700 font-mono">A-D</kbd>
                    <kbd class="px-1.5 py-0.5 bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700 font-mono">1-4</kbd>
                    <span>作答 ·</span>
                    <kbd class="px-1.5 py-0.5 bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700 font-mono">Enter</kbd>
                    <span>下一題 ·</span>
                    <kbd class="px-1.5 py-0.5 bg-slate-100 dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700 font-mono">S</kbd>
                    <span>發音</span>
                </div>
            </div>

            <!-- 題目主卡片 -->
            <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-md border border-slate-200/90 dark:border-slate-800 p-6 sm:p-8 mb-4 relative overflow-hidden">
                <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-academy-800 via-indigo-500 to-sky-500"></div>

                <div class="flex items-center justify-between gap-2 mb-5">
                    <div class="flex items-center gap-2">
                        <span id="quizWordId" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs font-bold">#001</span>
                        <span id="quizWordStatus" class="px-2.5 py-1 rounded-lg text-xs font-semibold"></span>
                    </div>
                    <span id="quizModeHint" class="text-xs font-medium text-slate-400 dark:text-slate-500">請選出正確的中文解釋</span>
                </div>

                <div class="text-center py-3 sm:py-5">
                    <div class="inline-flex items-center justify-center gap-3 flex-wrap">
                        <h2 id="quizPromptText" class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-academy-900 dark:text-white tracking-tight break-words max-w-full">
                            captivate
                        </h2>
                        <button id="btnQuizSpeak" type="button" class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-indigo-50 hover:bg-indigo-100 dark:bg-indigo-950 dark:hover:bg-indigo-900 text-indigo-600 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800 shadow-sm transition active:scale-90 shrink-0" title="朗讀英文發音 (S)" aria-label="朗讀英文發音">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
                        </button>
                    </div>

                    <!-- 模式 2 答題後顯示發音按鈕 -->
                    <div id="mode2AnswerReveal" class="hidden mt-4">
                        <button id="btnMode2SpeakAnswer" type="button" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-50 hover:bg-indigo-100 dark:bg-indigo-950/80 dark:hover:bg-indigo-900 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800 text-sm font-bold transition active:scale-95">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
                            <span>聽發音：<span id="mode2AnswerWordText"></span></span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- ABCD 四選項網格 -->
            <div id="quizOptionsGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5"></div>

            <!-- 作答回饋與下一題列 -->
            <div id="quizFeedbackBar" class="hidden rounded-2xl p-4 border transition-all duration-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                <div class="flex items-start gap-3">
                    <div id="feedbackIcon" class="w-8 h-8 rounded-full flex items-center justify-center shrink-0 mt-0.5"></div>
                    <div>
