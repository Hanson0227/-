                // 模式 4-3 小測驗
                document.querySelectorAll('.m4-qtype-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        state.m4QuizType = btn.dataset.m4Qtype;
                        updateM4QuizTypeUI();
                        loadNextM4QuizQuestion();
                    });
                });
                document.getElementById('btnM4QuizSpeak').addEventListener('click', () => {
                    if (state.m4QuizWord) speakWord(state.m4QuizWord.en);
                });
                document.getElementById('btnM4QuizSpeakAnswer').addEventListener('click', () => {
                    if (state.m4QuizWord) speakWord(state.m4QuizWord.en);
                });
                document.getElementById('btnM4QuizNext').addEventListener('click', loadNextM4QuizQuestion);
                document.getElementById('btnM4QuizMarkLearned').addEventListener('click', () => {
                    if (!state.m4QuizWord) return;
                    graduateWordWithUndo(state.m4QuizWord.id);
                });

                // 全部單字表 Modal
                const allModal = document.getElementById('allWordsModal');
                document.getElementById('btnOpenAllWords').addEventListener('click', () => {
                    allModal.classList.remove('hidden');
                    renderAllWordsModal();
                });
                const closeAllModal = () => {
                    allModal.classList.add('hidden');
                    // 關閉後同步目前畫面狀態
                    if (state.mode === 'mode3' && state.fcWord) populateMode3Card(state.fcWord);
                    else if (state.mode === 'mode4') renderMode4();
                };
                document.getElementById('btnCloseAllWords').addEventListener('click', closeAllModal);
                allModal.addEventListener('click', (e) => { if (e.target === allModal) closeAllModal(); });

                document.getElementById('allWordsSearchInput').addEventListener('input', (e) => {
                    state.allSearch = e.target.value;
                    renderAllWordsModal();
                });
                document.querySelectorAll('.all-filter-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        state.allFilter = btn.dataset.allFilter;
                        renderAllWordsModal();
                    });
                });
                document.getElementById('allWordsContainer').addEventListener('click', (e) => {
                    const speakBtn = e.target.closest('[data-speak]');
                    if (speakBtn) {
                        speakWord(speakBtn.dataset.speak);
                        return;
                    }
                    const cycleBtn = e.target.closest('[data-cycle-id]');
                    if (cycleBtn) {
                        const id = parseInt(cycleBtn.dataset.cycleId, 10);
                        const cur = getWordStatus(id);
                        if (cur === 'unmarked') markWordUnlearned(id, true);
                        else if (cur === 'unlearned') markWordLearned(id);
                        else clearWordStatus(id);
                        renderAllWordsModal();
                    }
                });

                // 備份 / 還原 / 重置 Modal
                const backupModal = document.getElementById('backupModal');
                document.getElementById('btnOpenBackup').addEventListener('click', openBackupModal);
                document.getElementById('btnCloseBackup').addEventListener('click', () => backupModal.classList.add('hidden'));
                backupModal.addEventListener('click', (e) => { if (e.target === backupModal) backupModal.classList.add('hidden'); });
                document.getElementById('btnCopyBackup').addEventListener('click', copyBackupToClipboard);
                document.getElementById('btnDownloadBackup').addEventListener('click', downloadBackupJson);
                document.getElementById('btnImportBackup').addEventListener('click', importBackupString);

                document.getElementById('btnAskReset').addEventListener('click', () => {
                    document.getElementById('resetInitialRow').classList.add('hidden');
                    document.getElementById('resetConfirmRow').classList.remove('hidden');
                });
                document.getElementById('btnCancelReset').addEventListener('click', () => {
                    document.getElementById('resetConfirmRow').classList.add('hidden');
                    document.getElementById('resetInitialRow').classList.remove('hidden');
                });
                document.getElementById('btnConfirmReset').addEventListener('click', () => {
                    state.wordData = {};
                    state.stats = { total: 0, correct: 0, streak: 0 };
                    state.m4JustCelebrated = false;
                    saveState();
                    updateGlobalCounters();
                    backupModal.classList.add('hidden');
                    renderActiveMode();
                    showToast('已重置全部學習進度');
                });

                // 電腦鍵盤快捷鍵
                document.addEventListener('keydown', (e) => {
                    const tag = document.activeElement ? document.activeElement.tagName : '';
                    const modalOpen = !allModal.classList.contains('hidden') || !backupModal.classList.contains('hidden');
                    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
                    if (e.key === 'Escape' && modalOpen) {
                        closeAllModal();
                        backupModal.classList.add('hidden');
                        return;
                    }
                    if (modalOpen) return;

                    const key = e.key.toLowerCase();

                    if (state.mode === 'mode1' || state.mode === 'mode2') {
                        if (!state.quizAnswered) {
                            const map = { a: 0, '1': 0, b: 1, '2': 1, c: 2, '3': 2, d: 3, '4': 3 };
                            if (key in map) {
                                e.preventDefault();
                                handleQuizAnswer(map[key]);
                            }
                        } else if (e.key === 'Enter' || e.key === ' ') {
                            e.preventDefault();
                            loadNextQuizQuestion();
                        }
                        if (key === 's' && state.quizWord && (state.mode === 'mode1' || state.quizAnswered)) {
                            speakWord(state.quizWord.en);
                        }
                    } else if (state.mode === 'mode3') {
                        if (e.key === ' ' || e.key === 'Enter') {
                            e.preventDefault();
                            toggleMode3Flip();
                        } else if (e.key === 'ArrowLeft') {
                            e.preventDefault();
                            handleMode3Decision(false);
                        } else if (e.key === 'ArrowRight') {
                            e.preventDefault();
                            handleMode3Decision(true);
                        } else if (key === 's' && state.fcWord) {
                            speakWord(state.fcWord.en);
                        }
                    } else if (state.mode === 'mode4' && getUnlearnedWords().length > 0) {
                        if (state.m4Submode === 'cards') {
                            if (e.key === ' ' || e.key === 'Enter') {
                                e.preventDefault();
                                toggleM4CardFlip();
                            } else if (e.key === 'ArrowLeft') {
                                e.preventDefault();
                                handleM4CardDecision(false);
                            } else if (e.key === 'ArrowRight') {
                                e.preventDefault();
                                handleM4CardDecision(true);
                            } else if (key === 's' && state.m4FcWord) {
                                speakWord(state.m4FcWord.en);
                            }
                        } else if (state.m4Submode === 'quiz') {
                            if (!state.m4QuizAnswered) {
                                const map = { a: 0, '1': 0, b: 1, '2': 1, c: 2, '3': 2, d: 3, '4': 3 };
                                if (key in map) {
                                    e.preventDefault();
                                    handleM4QuizAnswer(map[key]);
                                }
                            } else if (e.key === 'Enter' || e.key === ' ') {
                                e.preventDefault();
                                loadNextM4QuizQuestion();
                            }
                            if (key === 's' && state.m4QuizWord && (state.m4QuizType === 'en2zh' || state.m4QuizAnswered)) {
                                speakWord(state.m4QuizWord.en);
                            }
                        }
                    }
                });
            }

            /* =========================================================================
             * 12. 初始化應用程式
             * ========================================================================= */
            function init() {
                loadState();
                applyTheme();
                updateGlobalCounters();
                bindEvents();
                renderActiveMode();

                if ('speechSynthesis' in window) {
                    window.speechSynthesis.getVoices();
                }
            }

            window.addEventListener('DOMContentLoaded', init);
        })();
    </script>
</body>
</html>
