            function loadNextFlashcard(animateDir) {
                const pool = getRangePool();
                document.getElementById('fcPoolCountText').textContent = `範圍內共 ${pool.length} 張`;

                const nextWord = pickWeightedWord(pool, state.lastFcId);
                if (!nextWord) return;

                const stage = document.getElementById('fcStage');
                const inner = document.getElementById('fcInner');

                if (!animateDir) {
                    state.fcWord = nextWord;
                    state.lastFcId = nextWord.id;
                    state.fcFlipped = false;
                    inner.classList.remove('is-flipped');
                    populateMode3Card(nextWord);
                    return;
                }

                if (state.fcTransitioning) return;
                state.fcTransitioning = true;

                const exitCls = animateDir === 'left' ? 'card-exit-left' : 'card-exit-right';
                stage.classList.add(exitCls);

                setTimeout(() => {
                    inner.style.transition = 'none';
                    inner.classList.remove('is-flipped');
                    state.fcFlipped = false;
                    state.fcWord = nextWord;
                    state.lastFcId = nextWord.id;
                    populateMode3Card(nextWord);

                    void inner.offsetWidth;
                    inner.style.transition = '';

                    stage.classList.remove(exitCls);
                    stage.classList.add('card-enter');
                    void stage.offsetWidth;
                    stage.classList.remove('card-enter');

                    setTimeout(() => { state.fcTransitioning = false; }, 180);
                }, 220);
            }

            function toggleMode3Flip() {
                if (state.fcTransitioning || !state.fcWord) return;
                state.fcFlipped = !state.fcFlipped;
                document.getElementById('fcInner').classList.toggle('is-flipped', state.fcFlipped);
            }

            function handleMode3Decision(isLearned) {
                if (!state.fcWord || state.fcTransitioning) return;
                const word = state.fcWord;
                if (isLearned) {
                    markWordLearned(word.id);
                    playTone(true);
                    loadNextFlashcard('right');
                } else {
                    markWordUnlearned(word.id, true);
                    loadNextFlashcard('left');
                }
            }

